{
  "name": "xiaobao-jizhang",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:prod": "node scripts/dev.mjs --target=prod",
    "fat": "node scripts/dev.mjs --target=prod",
    "prod": "node scripts/dev.mjs --target=prod",
    "docker:infra:up": "docker compose -f docker-compose.infra.yml up -d",
    "docker:infra:down": "docker compose -f docker-compose.infra.yml down",
    "docker:full:up": "docker compose up -d --build",
    "docker:full:down": "docker compose down",
    "docker:full:logs": "docker compose logs -f backend frontend",
    "test:dev": "node --test scripts/*.test.mjs",
    "typecheck": "pnpm --dir backend typecheck && pnpm --dir frontend typecheck",
    "test": "pnpm test:dev && pnpm --dir backend test && pnpm --dir frontend test",
    "lint": "pnpm --dir backend lint && pnpm --dir frontend lint",
    "test:coverage": "pnpm --dir backend test:cov",
    "build": "pnpm --dir backend build && pnpm --dir frontend build"
  }
}
