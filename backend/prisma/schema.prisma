datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

enum LedgerType {
  PERSONAL
  SHARED
}

enum LedgerMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum LedgerMemberStatus {
  ACTIVE
  LEFT
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
  DECLINED
}

enum AccountVisibility {
  SHARED
  PRIVATE
}

enum AccountType {
  CASH
  BANK_CARD
  CREDIT_CARD
  ALIPAY
  WECHAT
  OTHER
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

enum TransactionSource {
  MANUAL
  IMPORT
  RECURRING
  OFFLINE_SYNC
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum AdminAuditResult {
  SUCCESS
  FAILURE
}

model User {
  id                  String                @id @default(uuid())
  username            String                @unique
  passwordHash        String                @map("password_hash")
  nickname            String?
  email               String?               @unique
  avatar              String?
  isActive            Boolean               @default(true) @map("is_active")
  ledgersCreated      Ledger[]              @relation("LedgerCreator")
  ledgerMemberships   LedgerMember[]
  ledgerPreference    UserLedgerPreference?
  ledgerCopyRequests  LedgerCopyRequest[]
  sentInvitations     LedgerInvitation[]    @relation("InvitationSender")
  refreshSessions     RefreshSession[]
  createdTransactions Transaction[]         @relation("TransactionCreator")
  updatedTransactions Transaction[]         @relation("TransactionUpdater")
  paidTransactions    Transaction[]         @relation("TransactionPayer")
  ownedAccounts       Account[]             @relation("AccountOwner")
  auditLogs           TransactionAuditLog[] @relation("AuditOperator")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@map("user")
}

model Ledger {
  id                 String                 @id @default(uuid())
  name               String
  type               LedgerType             @default(PERSONAL)
  creatorId          String                 @map("creator_id")
  defaultCurrency    String                 @default("CNY") @map("default_currency")
  timezone           String                 @default("Asia/Shanghai")
  icon               String?
  color              String?
  isArchived         Boolean                @default(false) @map("is_archived")
  creator            User                   @relation("LedgerCreator", fields: [creatorId], references: [id])
  members            LedgerMember[]
  currentPreferences UserLedgerPreference[] @relation("CurrentPreferenceLedger")
  defaultPreferences UserLedgerPreference[] @relation("DefaultPreferenceLedger")
  sourceCopyRequests LedgerCopyRequest[]    @relation("CopySourceLedger")
  targetCopyRequest  LedgerCopyRequest?     @relation("CopyTargetLedger")
  invitations        LedgerInvitation[]
  accounts           Account[]
  categories         Category[]
  transactions       Transaction[]
  budgets            Budget[]
  auditLogs          TransactionAuditLog[]
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  @@index([creatorId])
  @@map("ledger")
}

model UserLedgerPreference {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  currentLedgerId String?  @map("current_ledger_id")
  defaultLedgerId String?  @map("default_ledger_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentLedger   Ledger?  @relation("CurrentPreferenceLedger", fields: [currentLedgerId], references: [id], onDelete: SetNull)
  defaultLedger   Ledger?  @relation("DefaultPreferenceLedger", fields: [defaultLedgerId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([currentLedgerId])
  @@index([defaultLedgerId])
  @@map("user_ledger_preference")
}

model LedgerCopyRequest {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  clientRequestId String   @map("client_request_id")
  sourceLedgerId  String?  @map("source_ledger_id")
  targetLedgerId  String?  @unique @map("target_ledger_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceLedger    Ledger?  @relation("CopySourceLedger", fields: [sourceLedgerId], references: [id], onDelete: SetNull)
  targetLedger    Ledger?  @relation("CopyTargetLedger", fields: [targetLedgerId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([userId, clientRequestId])
  @@index([sourceLedgerId])
  @@map("ledger_copy_request")
}

model LedgerMember {
  id           String             @id @default(uuid())
  ledgerId     String             @map("ledger_id")
  userId       String             @map("user_id")
  role         LedgerMemberRole   @default(VIEWER)
  status       LedgerMemberStatus @default(ACTIVE)
  joinedAt     DateTime           @default(now()) @map("joined_at")
  lastActiveAt DateTime?          @map("last_active_at")
  ledger       Ledger             @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ledgerId, userId])
  @@index([userId, status])
  @@map("ledger_member")
}

model RefreshSession {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  tokenHash           String    @unique @map("token_hash")
  deviceName          String?   @map("device_name")
  userAgent           String?   @map("user_agent")
  lastUsedAt          DateTime? @map("last_used_at")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @unique @map("replaced_by_session_id")
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@index([userId, expiresAt])
  @@map("refresh_session")
}

model LedgerInvitation {
  id          String           @id @default(uuid())
  ledgerId    String           @map("ledger_id")
  inviterId   String           @map("inviter_id")
  targetEmail String           @map("target_email")
  tokenHash   String           @unique @map("token_hash")
  role        LedgerMemberRole @default(EDITOR)
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime         @map("expires_at")
  acceptedAt  DateTime?        @map("accepted_at")
  ledger      Ledger           @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  inviter     User             @relation("InvitationSender", fields: [inviterId], references: [id])
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([ledgerId, status])
  @@index([ledgerId, targetEmail, status])
  @@map("ledger_invitation")
}

model Account {
  id                  String            @id @default(uuid())
  ledgerId            String            @map("ledger_id")
  ownerId             String?           @map("owner_id")
  name                String
  type                AccountType
  visibility          AccountVisibility @default(SHARED)
  initialBalanceCents Int               @default(0) @map("initial_balance_cents")
  currentBalanceCents Int               @default(0) @map("current_balance_cents")
  includeInAssets     Boolean           @default(true) @map("include_in_assets")
  icon                String?
  color               String?
  isActive            Boolean           @default(true) @map("is_active")
  ledger              Ledger            @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  owner               User?             @relation("AccountOwner", fields: [ownerId], references: [id])
  transactions        Transaction[]     @relation("TransactionAccount")
  outgoingTransfers   Transaction[]     @relation("TransactionFromAccount")
  incomingTransfers   Transaction[]     @relation("TransactionToAccount")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  @@index([ledgerId, isActive])
  @@index([ownerId, visibility])
  @@map("account")
}

model Category {
  id           String        @id @default(uuid())
  ledgerId     String        @map("ledger_id")
  type         CategoryType
  name         String
  parentId     String?       @map("parent_id")
  icon         String?
  color        String?
  sortOrder    Int           @default(0) @map("sort_order")
  isSystem     Boolean       @default(false) @map("is_system")
  isActive     Boolean       @default(true) @map("is_active")
  ledger       Ledger        @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]
  budgets      Budget[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([ledgerId, type, parentId, name])
  @@index([ledgerId, type, isActive])
  @@index([ledgerId, type, parentId, sortOrder])
  @@map("category")
}

model Transaction {
  id              String                @id @default(uuid())
  ledgerId        String                @map("ledger_id")
  type            TransactionType
  amountCents     Int                   @map("amount_cents")
  occurredAt      DateTime              @map("occurred_at")
  title           String?
  note            String?
  categoryId      String?               @map("category_id")
  accountId       String?               @map("account_id")
  fromAccountId   String?               @map("from_account_id")
  toAccountId     String?               @map("to_account_id")
  transferGroupId String?               @map("transfer_group_id")
  source          TransactionSource     @default(MANUAL)
  clientRequestId String                @map("client_request_id")
  createdById     String                @map("created_by_id")
  updatedById     String                @map("updated_by_id")
  payerId         String?               @map("payer_id")
  version         Int                   @default(1)
  deletedAt       DateTime?             @map("deleted_at")
  ledger          Ledger                @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  category        Category?             @relation(fields: [categoryId], references: [id])
  account         Account?              @relation("TransactionAccount", fields: [accountId], references: [id])
  fromAccount     Account?              @relation("TransactionFromAccount", fields: [fromAccountId], references: [id])
  toAccount       Account?              @relation("TransactionToAccount", fields: [toAccountId], references: [id])
  createdBy       User                  @relation("TransactionCreator", fields: [createdById], references: [id])
  updatedBy       User                  @relation("TransactionUpdater", fields: [updatedById], references: [id])
  payer           User?                 @relation("TransactionPayer", fields: [payerId], references: [id])
  auditLogs       TransactionAuditLog[]
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@unique([ledgerId, clientRequestId])
  @@index([ledgerId, occurredAt])
  @@index([ledgerId, type, occurredAt])
  @@index([ledgerId, categoryId, occurredAt])
  @@index([ledgerId, payerId, occurredAt])
  @@map("transaction")
}

model TransactionAuditLog {
  id            String      @id @default(uuid())
  ledgerId      String      @map("ledger_id")
  transactionId String      @map("transaction_id")
  operatorId    String      @map("operator_id")
  action        String
  beforeData    Json?       @map("before_data")
  afterData     Json?       @map("after_data")
  ledger        Ledger      @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  operator      User        @relation("AuditOperator", fields: [operatorId], references: [id])
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([ledgerId, createdAt])
  @@index([transactionId, createdAt])
  @@map("transaction_audit_log")
}

model Budget {
  id          String    @id @default(uuid())
  ledgerId    String    @map("ledger_id")
  categoryId  String?   @map("category_id")
  periodStart DateTime  @map("period_start")
  periodEnd   DateTime  @map("period_end")
  amountCents Int       @map("amount_cents")
  ledger      Ledger    @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([ledgerId, categoryId, periodStart, periodEnd])
  @@index([ledgerId, periodStart, periodEnd])
  @@map("budget")
}

model AdminUser {
  id                  String                @id @default(uuid())
  username            String                @unique
  passwordHash        String                @map("password_hash")
  displayName         String                @map("display_name")
  isActive            Boolean               @default(true) @map("is_active")
  lastLoginAt         DateTime?             @map("last_login_at")
  roles               AdminUserRole[]
  refreshSessions     AdminRefreshSession[]
  auditLogs           AdminAuditLog[]       @relation("AdminAuditOperator")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@index([isActive, createdAt])
  @@map("admin_user")
}

model AdminRole {
  id          String                @id @default(uuid())
  code        String                @unique
  name        String
  description String?
  isBuiltIn   Boolean               @default(false) @map("is_built_in")
  users       AdminUserRole[]
  permissions AdminRolePermission[]
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@map("admin_role")
}

model AdminPermission {
  id          String                @id @default(uuid())
  code        String                @unique
  name        String
  description String?
  roles       AdminRolePermission[]
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@map("admin_permission")
}

model AdminUserRole {
  adminUserId String    @map("admin_user_id")
  roleId      String    @map("role_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@id([adminUserId, roleId])
  @@index([roleId])
  @@map("admin_user_role")
}

model AdminRolePermission {
  roleId       String          @map("role_id")
  permissionId String          @map("permission_id")
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime        @default(now()) @map("created_at")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("admin_role_permission")
}

model AdminRefreshSession {
  id                  String    @id @default(uuid())
  adminUserId         String    @map("admin_user_id")
  tokenHash           String    @unique @map("token_hash")
  deviceName          String?   @map("device_name")
  userAgent           String?   @map("user_agent")
  lastUsedAt          DateTime? @map("last_used_at")
  expiresAt           DateTime  @map("expires_at")
  revokedAt           DateTime? @map("revoked_at")
  replacedBySessionId String?   @unique @map("replaced_by_session_id")
  adminUser           AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([adminUserId, revokedAt])
  @@index([adminUserId, expiresAt])
  @@map("admin_refresh_session")
}

model AdminAuditLog {
  id          String          @id @default(uuid())
  adminUserId String          @map("admin_user_id")
  requestId   String          @map("request_id")
  action      String
  targetType  String          @map("target_type")
  targetId    String?         @map("target_id")
  reason      String?
  beforeData  Json?           @map("before_data")
  afterData   Json?           @map("after_data")
  result      AdminAuditResult
  errorCode   String?         @map("error_code")
  ip          String?
  userAgent   String?         @map("user_agent")
  adminUser   AdminUser       @relation("AdminAuditOperator", fields: [adminUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([adminUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([requestId])
  @@index([createdAt])
  @@map("admin_audit_log")
}
