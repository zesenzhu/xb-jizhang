DATABASE_URL=postgresql://jizhang:jizhang_dev_password@localhost:5439/jizhang?schema=public
PORT=8091
REDIS_URL=redis://localhost:6389
JWT_ACCESS_SECRET=development-only-change-this-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_SECONDS=2592000
JWT_ADMIN_ACCESS_SECRET=development-only-change-this-admin-secret
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_SESSION_TTL_SECONDS=2592000
CORS_ORIGINS=http://localhost:8090

# 可选：执行 prisma db seed 时创建首个 SUPER_ADMIN，不要提交真实密码
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_DISPLAY_NAME=超级管理员

# 第四期账单图片附件（默认关闭，完成对象存储和备份验证后再开启）
ATTACHMENT_ENABLED=false
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_PER_TRANSACTION=5
ATTACHMENT_USER_QUOTA_BYTES=2147483648
ATTACHMENT_CLEANUP_INTERVAL_SECONDS=600
OBJECT_STORAGE_PROVIDER=minio
OBJECT_STORAGE_UPLOAD_URL_TTL_SECONDS=600
OBJECT_STORAGE_READ_URL_TTL_SECONDS=300

# 本地 MinIO；MINIO_PUBLIC_ENDPOINT 必须是浏览器可访问地址
MINIO_INTERNAL_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=jizhang-attachments
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_FORCE_PATH_STYLE=true

# 生产 OSS；OSS_ENDPOINT 必须是浏览器可访问的公网地址
OSS_REGION=oss-cn-shenzhen
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
OSS_INTERNAL_ENDPOINT=https://oss-cn-shenzhen-internal.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
STORAGE_CORS_ORIGINS=http://localhost:8090
