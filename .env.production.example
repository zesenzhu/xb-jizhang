# 生产环境变量字段模板：实际生产值通过 GitHub production Environment 注入。
# 不要把真实值写入本文件或提交到 Git。

DB_USER=jizhang
DB_PASSWORD=请替换为仅包含字母和数字的强随机密码
DB_NAME=jizhang

JWT_ACCESS_SECRET=请替换为普通用户强随机密钥
JWT_ADMIN_ACCESS_SECRET=请替换为不同的管理员强随机密钥
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_SECONDS=2592000
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_SESSION_TTL_SECONDS=2592000

# 同源部署时使用记账域名；多个来源用逗号分隔。
CORS_ORIGINS=https://jizhang.xiaobao.work

# 仅绑定服务器本机，外部访问通过 Nginx。
BACKEND_PORT=8091
FRONTEND_PORT=8090

# 第四期账单图片附件：生产使用阿里云 OSS 私有 Bucket。
# OSS_ACCESS_KEY_ID 和 OSS_ACCESS_KEY_SECRET 由 GitHub production Secret 注入，不写入此模板。
ATTACHMENT_ENABLED=false
OBJECT_STORAGE_PROVIDER=aliyun-oss
OSS_REGION=oss-cn-heyuan
OSS_ENDPOINT=https://oss-cn-heyuan.aliyuncs.com
OSS_INTERNAL_ENDPOINT=https://oss-cn-heyuan-internal.aliyuncs.com
OSS_BUCKET=xiaobao-jizhang
OBJECT_STORAGE_UPLOAD_URL_TTL_SECONDS=600
OBJECT_STORAGE_READ_URL_TTL_SECONDS=300
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_PER_TRANSACTION=5
ATTACHMENT_USER_QUOTA_BYTES=2147483648
ATTACHMENT_CLEANUP_INTERVAL_SECONDS=600
