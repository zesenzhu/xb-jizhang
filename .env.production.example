# 生产环境变量字段模板：实际生产值通过 GitHub production Environment 注入。
# 不要把真实值写入本文件或提交到 Git。

DB_USER=jizhang
DB_PASSWORD=请替换为仅包含字母和数字的强随机密码
DB_NAME=jizhang

JWT_ACCESS_SECRET=请替换为普通用户强随机密钥
JWT_ADMIN_ACCESS_SECRET=请替换为不同的管理员强随机密钥
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_SECONDS=2592000
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
ADMIN_REFRESH_SESSION_TTL_SECONDS=2592000

# 同源部署时使用记账域名；多个来源用逗号分隔。
CORS_ORIGINS=https://jizhang.xiaobao.work

# 仅绑定服务器本机，外部访问通过 Nginx。
BACKEND_PORT=8091
FRONTEND_PORT=8090
